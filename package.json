{
  "name": "secondary-sidebar-terminal",
  "displayName": "Secondary Sidebar Terminal",
  "description": "Native VS Code terminals in a right editor group, alongside your bottom terminals.",
  "version": "0.5.1",
  "publisher": "local-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "secondaryTerminal.open",
        "title": "開啟右側原生終端機",
        "category": "Secondary Terminal",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "secondaryTerminal.new",
        "title": "新增右側原生終端機",
        "category": "Secondary Terminal",
        "icon": "$(add)"
      },
      {
        "command": "secondaryTerminal.close",
        "title": "關閉目前右側原生終端機",
        "category": "Secondary Terminal",
        "icon": "$(trash)"
      },
      {
        "command": "secondaryTerminal.restore",
        "title": "還原舊版移走的原生 Terminal 至底部",
        "category": "Secondary Terminal",
        "icon": "$(layout-panel)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "secondaryTerminal.open",
          "when": "view == terminal",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "Secondary Terminal",
      "properties": {
        "secondaryTerminal.shellPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "右側原生終端機使用的 shell 執行檔。留空時使用 VS Code 預設終端機設定。"
        },
        "secondaryTerminal.shellArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "傳給右側原生 shell 的參數。"
        }
      }
    }
  },
  "scripts": {
    "check": "node --check src/extension.js && node --check test/integration.js && node --check test/run.js",
    "test": "node test/run.js",
    "package": "vsce package --target win32-x64 --allow-missing-repository",
    "vscode:prepublish": "npm run check"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "playwright-core": "1.64.1"
  },
  "extensionKind": [
    "workspace"
  ]
}
